# ============================================================================
# Frontend build-time config (Vite). Copy to frontend/.env.local for local dev.
# ============================================================================

# Base URL for the Moneyball API.
#   - Leave EMPTY to use same-origin "/api" (nginx proxy in Docker, or the
#     Vite dev proxy locally). This is the recommended default.
#   - Set to a full origin (e.g. https://moneyball-api.onrender.com) when the
#     API is deployed on a separate domain (e.g. frontend on Vercel/Netlify).
VITE_API_BASE_URL=

# Local dev only: where the Vite dev server proxies /api to.
# Defaults to http://127.0.0.1:8011 if unset.
VITE_PROXY_TARGET=http://127.0.0.1:8000
